# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API Keys). Nunca coloque a service role key aqui.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Opcional: endereço público usado nos links enviados por e-mail.
# Na Vercel, configure com a URL de produção (ex.: https://meu-armario.vercel.app).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
